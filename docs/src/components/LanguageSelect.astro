---
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
const { entry, lang } = Astro.locals.starlightRoute;
const isErrorPage = entry.id === '404' || entry.id.endsWith('/404');
const zh = lang.toLowerCase().startsWith('zh');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{isErrorPage ? (
  <nav aria-label={zh ? '选择语言' : 'Select language'}>
    <a href={`${base}/404.html`} lang="en" aria-current={!zh ? 'page' : undefined}>English</a>
    <a href={`${base}/zh-cn/404/`} lang="zh-CN" aria-current={zh ? 'page' : undefined}>简体中文</a>
  </nav>
) : <DefaultLanguageSelect />}

<style>
  nav { display:flex; align-items:center; gap:.75rem; font-size:.75rem; }
  a { color:var(--sl-color-gray-2); text-decoration:none; white-space:nowrap; }
  a[aria-current] { color:var(--sl-color-text-accent); font-weight:600; }
  a:hover { text-decoration:underline; text-underline-offset:3px; }
</style>
