---
import { Icon } from '@astrojs/starlight/components';

const zh = Astro.locals.starlightRoute.lang.toLowerCase().startsWith('zh');
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const base = `${root}${zh ? 'zh-cn/' : ''}`;
const features = zh ? [
  { title: '标签里可以写 Rust', description: '属性、条件和循环直接使用 Rust 表达式。Fragment 组合多个节点，key 为交互列表提供稳定标识。', href: 'usage/syntax/', link: '语法参考' },
  { title: '样式映射到 GPUI 方法', description: '静态工具类、状态变体和项目设计令牌在编译时展开。动态值也可以直接传给 Rust 属性。', href: 'guides/theming/', link: '主题与设计令牌' },
  { title: '编辑器和 CLI 都有工具', description: '编辑器提供补全、诊断和展开预览；CLI 可以格式化 RSX、检查主题、转换 JSX。', href: 'guides/tooling/', link: '工具配置' },
] : [
  { title: 'Rust expressions inside tags', description: 'Use Rust for attributes, conditions, and loops. Compose nodes with fragments and give interactive lists stable keys.', href: 'usage/syntax/', link: 'Syntax reference' },
  { title: 'Styles become GPUI methods', description: 'Static utilities, state variants, and project design tokens expand at compile time. Pass dynamic values through Rust attributes.', href: 'guides/theming/', link: 'Themes and design tokens' },
  { title: 'Editor and CLI tools', description: 'Get completion, diagnostics, and expansion previews in your editor. Format RSX, check themes, and convert JSX with the CLI.', href: 'guides/tooling/', link: 'Tooling setup' },
];
const paths = zh ? [
  { title: '快速开始', description: '安装依赖，运行第一个视图。', href: 'getting-started/' },
  { title: '迁移指南', description: '调整 GPUI Kit、工具 API 和间距配置。', href: 'guides/migration/' },
  { title: '可运行示例', description: '从计数器开始，尝试九个原生示例。', href: 'examples/demos/' },
  { title: 'API 参考', description: '速查宏、标签和属性映射。', href: 'reference/api/' },
] : [
  { title: 'Getting started', description: 'Install dependencies and run your first view.', href: 'getting-started/' },
  { title: 'Migration guide', description: 'Update GPUI Kit, tooling APIs, and spacing.', href: 'guides/migration/' },
  { title: 'Runnable demos', description: 'Try nine native examples, from counters to consoles.', href: 'examples/demos/' },
  { title: 'API reference', description: 'Find macros, tags, and attribute mappings.', href: 'reference/api/' },
];
const macros = zh ? [
  ['rsx!', '默认宽松模式，可逐步接入。'],
  ['rsx_strict!', '不支持的静态 class 在编译时报错。'],
  ['rsx_permissive!', '显式选择宽松模式。'],
  ['rsx_tw!', 'Tailwind 间距刻度，每单位 4px。'],
  ['rsx_expand!', '返回生成的 Rust 字符串，用于调试。'],
] : [
  ['rsx!', 'Default permissive mode for gradual adoption.'],
  ['rsx_strict!', 'Reject unsupported static classes at compile time.'],
  ['rsx_permissive!', 'Select permissive mode explicitly.'],
  ['rsx_tw!', 'Tailwind spacing, with 4px per unit.'],
  ['rsx_expand!', 'Return generated Rust as a string for debugging.'],
];
---

<div class="home-overview not-content">
  <section class="features" aria-label={zh ? '语法、样式与工具' : 'Syntax, styles, and tools'}>
    {features.map(feature => <article>
      <h2>{feature.title}</h2>
      <p>{feature.description}</p>
      <a class="text-link" href={`${base}${feature.href}`}>{feature.link}<Icon name="right-arrow" size=".85rem" /></a>
    </article>)}
  </section>

  <section class="app-example" aria-labelledby="example-title">
    <div class="example-copy">
      <h2 id="example-title">{zh ? '事故响应控制台' : 'Incident Console'}</h2>
      <p>{zh ? '事故响应控制台是仓库里的原生 GPUI 示例，包含多栏布局、事件筛选、状态切换和时间线。' : 'The Incident Console is the repository’s native GPUI example, with a multi-pane layout, incident filters, state transitions, and an event timeline.'}</p>
      <p>{zh ? '从视图拆分到交互逻辑，都有对应的源码可读。' : 'Read the source to see how the views and interactions fit together.'}</p>
      <a class="text-link" href={`${base}examples/incident-console/`}>{zh ? '阅读示例与运行说明' : 'Explore the example'}<Icon name="right-arrow" size=".9rem" /></a>
    </div>
    <figure class="example-image">
      <a href={`${base}examples/incident-console/`}>
        <img src={`${root}incident-console.png`} width="1600" height="1061" loading="lazy" decoding="async" alt={zh ? '事故响应控制台的原生应用截图，展示侧栏、事件队列和详情面板' : 'Native Incident Console application showing navigation, the incident queue, and the detail panel'} />
      </a>
      <figcaption>{zh ? 'Incident Console · 原生应用截图' : 'Incident Console · Native application screenshot'}</figcaption>
    </figure>
  </section>

  <div class="reference-sections">
    <section class="reading-paths" aria-labelledby="find-your-path">
      <h2 id="find-your-path">{zh ? '阅读文档' : 'Documentation'}</h2>
      <nav class="path-list" aria-labelledby="find-your-path">
        {paths.map(path => <a href={`${base}${path.href}`} class="path-row">
          <span class="path-copy"><strong>{path.title}</strong><span>{path.description}</span></span>
          <Icon name="right-arrow" size=".95rem" />
        </a>)}
      </nav>
    </section>

    <section class="macro-section" aria-labelledby="choose-a-macro">
      <h2 id="choose-a-macro">{zh ? '选择宏' : 'Choose a macro'}</h2>
      <p class="spacing-note">{zh ? <>默认数值间距按像素计算：<code>gap-4</code> 是 4px。Tailwind 刻度需显式启用。</> : <>Numeric spacing uses pixels by default: <code>gap-4</code> is 4px. Opt in to the Tailwind scale when needed.</>}</p>
      <dl class="macro-list">{macros.map(([macro, description]) => <div><dt><code>{macro}</code></dt><dd>{description}</dd></div>)}</dl>
    </section>
  </div>

  <aside class="native-note">
    <p>{zh ? <><strong>关于在线预览：</strong>浏览器只近似展示静态布局。请在原生应用中验证渲染与交互；动态 class 使用运行时 matcher。</> : <><strong>About the playground:</strong> The browser approximates static layout. Verify rendering and interactions in your native application. Dynamic classes use a runtime matcher.</>}</p>
  </aside>
</div>

<style>
  .home-overview { margin: 0; }
  .features { display: grid; gap: 2rem; padding-block: 2.75rem 3.5rem; }
  .features h2 { margin: 0 0 .65rem; color: var(--sl-color-white); font-size: 1rem; font-weight: 600; letter-spacing: -.02em; }
  .features p { max-width: 48ch; color: var(--sl-color-gray-2); font-size: .85rem; line-height: 1.9; }
  .text-link { display: inline-flex; align-items: center; gap: .55rem; margin-top: .9rem; color: var(--sl-color-text-accent); font-size: .8rem; font-weight: 550; text-decoration: none; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  .app-example { display: grid; gap: 2rem; align-items: center; padding: 2rem; border-radius: 10px; background: var(--rsx-surface-raised); }
  .example-copy h2 { max-width: 16ch; margin: 0 0 1.1rem; color: var(--sl-color-white); font-size: 1.65rem; line-height: 1.4; font-weight: 600; letter-spacing: -.035em; }
  .example-copy p { max-width: 42ch; color: var(--sl-color-gray-2); font-size: .85rem; line-height: 1.9; }
  .example-copy p + p { margin-top: .8rem; }
  .example-image { min-width: 0; margin: 0; }
  .example-image a { display: block; border: 1px solid var(--rsx-border); border-radius: 5px; overflow: hidden; }
  .example-image img { display: block; width: 100%; height: auto; }
  .example-image figcaption { margin-top: .65rem; color: var(--sl-color-gray-3); font-size: .65rem; }

  .reference-sections { display: grid; gap: 2.75rem; padding-block: 3.5rem 2.5rem; }
  .reference-sections h2 { margin: 0 0 1.25rem; color: var(--sl-color-white); font-size: 1.2rem; font-weight: 600; letter-spacing: -.025em; }
  .path-row { display: flex; align-items: center; gap: 1rem; padding-block: .85rem; color: var(--sl-color-gray-1); text-decoration: none; }
  .path-row:first-child { padding-top: 0; }
  .path-copy { display: grid; gap: .3rem; flex: 1; }
  .path-copy strong { font-size: .85rem; font-weight: 550; }
  .path-copy > span { color: var(--sl-color-gray-2); font-size: .75rem; line-height: 1.7; }
  .path-row svg { flex-shrink: 0; color: var(--sl-color-gray-3); }
  .path-row:hover strong { color: var(--sl-color-text-accent); text-decoration: underline; text-underline-offset: 4px; }
  .spacing-note { max-width: 52ch; color: var(--sl-color-gray-2); font-size: .8rem; line-height: 1.8; }
  .spacing-note code { color: var(--sl-color-gray-1); font-size: .75rem; }
  .macro-list { margin: .8rem 0 0; }
  .macro-list > div { display: grid; grid-template-columns: 9rem 1fr; gap: .5rem; padding-block: .6rem; }
  .macro-list dt { color: var(--sl-color-gray-1); font-size: .75rem; }
  .macro-list dd { margin: 0; color: var(--sl-color-gray-2); font-size: .75rem; line-height: 1.7; }
  .native-note { padding-block: 1.25rem 2rem; border-top: 1px solid var(--rsx-border); color: var(--sl-color-gray-3); font-size: .75rem; line-height: 1.9; }
  .native-note strong { font-weight: 550; color: var(--sl-color-gray-2); }

  @media (min-width: 50rem) {
    .features { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; }
    .app-example { grid-template-columns: .8fr 1.2fr; gap: 2.5rem; padding: 2.5rem; }
    .reference-sections { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }

  @media (max-width: 35rem) {
    .features { padding-block: 2rem 2.5rem; gap: 1.75rem; }
    .app-example { padding: 1.25rem; gap: 1.5rem; }
    .example-copy h2 { font-size: 1.45rem; }
    .reference-sections { padding-top: 2.5rem; }
    .macro-list > div { grid-template-columns: 1fr; gap: .25rem; padding-block: .65rem; }
  }
</style>
