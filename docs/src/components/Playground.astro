---
const zh = Astro.locals.starlightRoute.lang.toLowerCase().startsWith('zh');
const text = zh ? {
  theme: '主题（rsx.toml，可选）', themeHint: '静态 token 用于预览；Rust 表达式仅展示。', themeLimit: '主题超过 20,000 字符限制。',
  strict: '严格诊断', tailwind: 'Tailwind 刻度', format: '格式化 RSX', convert: '转换 JSX / TSX', share: '复制分享链接',
  source: '源代码', hint: '编辑 RSX，或粘贴 JSX 后转换', expansion: 'Rust 展开结果', preview: '静态布局预览',
  previewNote: '静态布局近似展示，实际效果请在原生应用中验证。', diagnostics: '诊断与转换提示',
  previewCount: '{count} 处样式或行为未模拟', previewLang: 'zh-CN', expression: '{ Rust 表达式 }', children: '{ 子节点 }', loop: '循环模板', component: '组件', unknown: '未知语法', behavior: '属性 / 交互行为', dynamic: '动态 class',
  loading: '正在加载 Rust 解析器…', checking: '正在检查…', limit: '源码超过 Playground 的 100,000 字符限制。',
  empty: '没有诊断信息。', failed: '解析器未能加载，请刷新页面重试。', tooLong: '源码过长，无法生成分享链接。',
  copied: '分享链接已复制。', address: '分享链接已更新到地址栏。', invalid: '分享链接无效，已使用默认示例。',
  diagnosticsCount: '{count} 条诊断。', conversionCount: '{count} 条转换提示需要检查。',
  tailwindScale: 'Tailwind：每单位 4px。', pixelScale: '默认：每单位 1px。',
  error: '错误', warning: '警告', info: '提示', review: '待检查', conversion: '转换提示',
} : {
  theme: 'Theme (rsx.toml, optional)', themeHint: 'Static tokens appear in preview; Rust expressions are displayed only.', themeLimit: 'Theme exceeds the 20,000 character limit.',
  strict: 'Strict diagnostics', tailwind: 'Tailwind scale', format: 'Format RSX', convert: 'Convert JSX / TSX', share: 'Copy share link',
  source: 'Source', hint: 'Edit RSX, or paste JSX to convert', expansion: 'Expanded Rust', preview: 'Static layout preview',
  previewNote: 'Approximate static layout. Verify the final result in your native app.', diagnostics: 'Diagnostics & conversion notes',
  previewCount: '{count} element(s) have styles or behavior omitted', previewLang: 'en', expression: '{ Rust expression }', children: '{ children }', loop: 'Loop template', component: 'Component', unknown: 'Unknown syntax', behavior: 'Attributes / interactions', dynamic: 'Dynamic classes',
  loading: 'Loading the Rust parser…', checking: 'Checking…', limit: 'Source exceeds the 100,000 character playground limit.',
  empty: 'No diagnostics.', failed: 'The parser could not load. Reload to retry.', tooLong: 'Source is too long for a share link.',
  copied: 'Share link copied.', address: 'Share link is in the address bar.', invalid: 'Invalid share link; using the example.',
  diagnosticsCount: '{count} diagnostic(s).', conversionCount: '{count} conversion note(s) need review.',
  tailwindScale: 'Tailwind: 4px per unit.', pixelScale: 'Default: 1px per unit.',
  error: 'error', warning: 'warning', info: 'info', review: 'review', conversion: 'conversion',
};
const example = `<div class="flex flex-col gap-[20px] p-[24px] w-full max-w-[420px] bg-white border border-zinc-200 rounded-lg">
    <span class="text-xs font-semibold text-teal-700">{"GPUI / RSX"}</span>
    <div class="flex flex-col gap-[8px]">
        <h1 class="text-xl font-semibold text-zinc-900">{"${zh ? '让想法变成原生界面' : 'Make room for your next idea'}"}</h1>
        <p class="text-sm text-zinc-500">{"${zh ? '编辑源码，实时查看布局与 Rust 展开。' : 'Edit the source. Explore the layout and generated Rust.'}"}</p>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-[12px]">
        <span class="text-xs text-zinc-500">{"${zh ? 'Rust 原生 · 编译期展开' : 'Native Rust. Compiled views.'}"}</span>
        <button class="px-[16px] py-[10px] bg-teal-700 text-white text-sm font-medium rounded-md hover:bg-teal-800">{"${zh ? '开始构建' : 'Start building'}"}</button>
    </div>
</div>`;
---
<div class="rsx-playground not-content" data-messages={JSON.stringify(text)} data-pagefind-ignore>
  <div class="workbench">
    <div class="toolbar">
      <div class="options">
        <label><input id="rsx-strict" type="checkbox" checked /> {text.strict}</label>
        <label><input id="rsx-tailwind" type="checkbox" /> {text.tailwind}</label>
      </div>
      <div class="actions">
        <button id="rsx-format" type="button">{text.format}</button>
        <button id="rsx-convert" type="button">{text.convert}</button>
        <button id="rsx-share" class="share-button" type="button">{text.share}</button>
      </div>
    </div>
    <div class="workspace">
      <div class="editor-panel">
        <div class="editor-heading"><label for="rsx-source">{text.source}<span>RSX</span></label><span class="editor-hint">{text.hint}</span></div>
        <textarea id="rsx-source" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="rsx-status">{example}</textarea>
      </div>
      <section class="preview-panel">
        <div class="panel-heading"><h2>{text.preview}</h2><span class="live-indicator">{zh ? '实时预览' : 'Live preview'}</span></div>
        <iframe id="rsx-preview" title={text.preview} sandbox=""></iframe>
        <p class="preview-note">{text.previewNote}</p>
      </section>
    </div>
    <details class="theme-panel">
      <summary><label for="rsx-theme">{text.theme}</label></summary>
      <p>{text.themeHint}</p>
      <textarea id="rsx-theme" spellcheck="false" aria-label={text.theme} placeholder={'[colors]\nbrand = "#0f766e"'}></textarea>
    </details>
    <p id="rsx-status" data-state="checking" role="status" aria-live="polite">{text.loading}</p>
  </div>
  <details id="rsx-preview-notes" class="preview-limitations" hidden>
    <summary id="rsx-preview-note-count"></summary>
    <ul id="rsx-preview-note-list"></ul>
  </details>
  <details class="expansion-panel">
    <summary><span>{text.expansion}</span><span class="language-label">RUST</span></summary>
    <pre tabindex="0" aria-label={text.expansion}><code id="rsx-expansion"></code></pre>
  </details>
  <section class="diagnostics-panel">
    <div class="panel-heading"><h2>{text.diagnostics}</h2><span id="rsx-diagnostic-count">0</span></div>
    <ul id="rsx-diagnostics" aria-label={text.diagnostics}></ul>
  </section>
</div>

<script>
  const messages = JSON.parse(document.querySelector<HTMLElement>('.rsx-playground')!.dataset.messages!) as Record<string, string>;
  const source = document.querySelector<HTMLTextAreaElement>('#rsx-source')!;
  const theme = document.querySelector<HTMLTextAreaElement>('#rsx-theme')!;
  const strict = document.querySelector<HTMLInputElement>('#rsx-strict')!;
  const tailwind = document.querySelector<HTMLInputElement>('#rsx-tailwind')!;
  const status = document.querySelector<HTMLElement>('#rsx-status')!;
  const expansion = document.querySelector<HTMLElement>('#rsx-expansion')!;
  const diagnostics = document.querySelector<HTMLUListElement>('#rsx-diagnostics')!;
  const preview = document.querySelector<HTMLIFrameElement>('#rsx-preview')!;
  const previewNotes = document.querySelector<HTMLDetailsElement>('#rsx-preview-notes')!;
  const previewNoteCount = document.querySelector<HTMLElement>('#rsx-preview-note-count')!;
  const previewNoteList = document.querySelector<HTMLUListElement>('#rsx-preview-note-list')!;
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const worker = new Worker(`${base}/playground/worker.js`, { type: 'module' });
  let sequence = 0;
  let timer: ReturnType<typeof setTimeout>;
  type Diagnostic = {start: number; end: number; message: string; severity?: string; target?: 'theme'};
  let conversionNotes: Diagnostic[] = [];
  const setStatus = (message: string, state = 'ready') => {
    status.textContent = message;
    status.dataset.state = state;
  };
  const request = (operation = 'analyze') => {
    clearTimeout(timer);
    const id = ++sequence;
    if (source.value.length > 100_000) { setStatus(messages.limit, 'error'); return; }
    if (theme.value.length > 20_000) { setStatus(messages.themeLimit, 'error'); return; }
    setStatus(messages.checking, 'checking');
    worker.postMessage({ id, operation, source: source.value, strict: strict.checked, tailwind: tailwind.checked, theme: theme.value });
  };
  const showDiagnostics = (items: Diagnostic[]) => {
    diagnostics.replaceChildren();
    document.querySelector('#rsx-diagnostic-count')!.textContent = String(items.length);
    for (const item of items) {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = `${messages[item.severity ?? 'review'] ?? item.severity}: ${item.message}`;
      button.dataset.severity = item.severity ?? 'review';
      button.addEventListener('click', () => {
        const editor = item.target === 'theme' ? theme : source;
        const bytes = new TextEncoder().encode(editor.value);
        const decoder = new TextDecoder();
        if (item.target === 'theme') theme.closest('details')!.open = true;
        editor.focus();
        editor.setSelectionRange(decoder.decode(bytes.slice(0,item.start)).length, decoder.decode(bytes.slice(0,item.end)).length);
      });
      li.append(button); diagnostics.append(li);
    }
    if (!items.length) { const li = document.createElement('li'); li.className = 'empty-diagnostics'; li.textContent = messages.empty; diagnostics.append(li); }
  };
  worker.onmessage = ({ data }) => {
    if (data.id !== sequence) return;
    if (data.error) { setStatus(data.error, 'error'); return; }
    if (data.operation === 'format') { source.value = data.result; request(); return; }
    if (data.operation === 'convert') {
      if (data.result.Err) { setStatus(data.result.Err, 'error'); return; }
      const converted = data.result.Ok.rsx as string;
      source.value = converted.startsWith('rsx_tw! {\n') ? converted.slice('rsx_tw! {\n'.length, -2) : converted;
      conversionNotes = data.result.Ok.diagnostics.map((note: {message: string}) => ({start: 0, end: 0, message: note.message, severity: 'conversion'}));
      request();
      return;
    }
    const result = data.result;
    expansion.textContent = result.expansion.Ok ?? result.expansion.Err;
    const html = result.preview.Ok ?? `<pre>${String(result.preview.Err).replace(/[&<>]/g, (c:string) => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]!))}</pre>`;
    // Keep renderer annotations outside the layout so they cannot change the UI being previewed.
    const template = document.createElement('template');
    template.innerHTML = html;
    const omitted = template.content.querySelectorAll<HTMLElement>('small.rsx-placeholder[title]');
    previewNoteList.replaceChildren();
    for (const annotation of omitted) {
      const item = document.createElement('li');
      const tag = document.createElement('code');
      tag.textContent = `<${annotation.parentElement?.dataset.rsxTag ?? 'element'}>`;
      const reason = document.createElement('span');
      reason.textContent = annotation.title.replaceAll('attribute/behavior', messages.behavior).replaceAll('dynamic class', messages.dynamic);
      item.append(tag, reason);
      previewNoteList.append(item);
      annotation.remove();
    }
    previewNotes.hidden = omitted.length === 0;
    previewNoteCount.textContent = messages.previewCount.replace('{count}', String(omitted.length));
    for (const placeholder of template.content.querySelectorAll<HTMLElement>('.rsx-placeholder')) {
      const label = placeholder.textContent ?? '';
      placeholder.textContent = ({'{expression}': messages.expression, '{children}': messages.children, 'loop template': messages.loop, 'unknown syntax': messages.unknown} as Record<string, string>)[label]
        ?? label.replace(/^component: /, `${messages.component} · `);
    }
    preview.srcdoc = `<!doctype html><html lang="${messages.previewLang}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><style>
      :root{color-scheme:light}*{box-sizing:border-box}body{margin:0;font:14px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif;color:#27272a;background:#f5f6f8}
      .preview-stage{min-height:100vh;display:grid;place-items:center;gap:16px;padding:28px;background-image:radial-gradient(#dce0e5 .7px,transparent .7px);background-size:16px 16px}
      .rsx-placeholder{display:inline-block;padding:3px 7px;border:1px dashed #94a3b8;border-radius:4px;background:#f1f5f9;color:#475569;font:11px/1.6 ui-monospace,monospace}
      pre{max-width:100%;white-space:pre-wrap;overflow-wrap:anywhere}
      @media(max-width:360px){.preview-stage{padding:16px}}
      </style></head><body><main class="preview-stage">${template.innerHTML}</main></body></html>`;
    const themeNotes: Diagnostic[] = (result.theme_diagnostics ?? []).map((message: string) => ({start:0,end:0,message,severity:'error',target:'theme'}));
    showDiagnostics([...themeNotes, ...result.diagnostics, ...conversionNotes]);
    const countMessage = messages.diagnosticsCount.replace('{count}', String(result.diagnostics.length + themeNotes.length));
    const notesMessage = conversionNotes.length ? messages.conversionCount.replace('{count}', String(conversionNotes.length)) : '';
    setStatus(`${countMessage} ${notesMessage} ${result.tailwind ? messages.tailwindScale : messages.pixelScale}`, themeNotes.length || result.diagnostics.some((item: Diagnostic) => item.severity === 'error') ? 'error' : 'ready');
  };
  worker.onerror = () => { setStatus(messages.failed, 'error'); };
  source.addEventListener('input', () => {
    ++sequence; // Invalidate pending results before the debounce, including format/convert replies.
    conversionNotes = [];
    clearTimeout(timer);
    setStatus(messages.checking, 'checking');
    timer = setTimeout(() => request(), 200);
  });
  theme.addEventListener('input', () => { ++sequence; clearTimeout(timer); timer = setTimeout(() => request(), 200); });
  strict.addEventListener('change', () => request());
  tailwind.addEventListener('change', () => request());
  document.querySelector('#rsx-format')!.addEventListener('click', () => request('format'));
  document.querySelector('#rsx-convert')!.addEventListener('click', () => request('convert'));
  document.querySelector('#rsx-share')!.addEventListener('click', async () => {
    const encoded = btoa(Array.from(new TextEncoder().encode(JSON.stringify({source:source.value,strict:strict.checked,tailwind:tailwind.checked,theme:theme.value})), byte => String.fromCharCode(byte)).join(''));
    if (encoded.length > 16_000) { setStatus(messages.tooLong, 'error'); return; }
    const url = new URL(location.href); url.hash = encoded;
    history.replaceState(null,'',url);
    try { await navigator.clipboard.writeText(url.href); setStatus(messages.copied); }
    catch { setStatus(messages.address); }
  });
  if (location.hash.length > 1 && location.hash.length <= 16_001) {
    try {
      const shared = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(location.hash.slice(1)),c => c.charCodeAt(0))));
      if (typeof shared.source === 'string' && shared.source.length <= 100_000 && (shared.theme === undefined || (typeof shared.theme === 'string' && shared.theme.length <= 20_000))) {
        source.value = shared.source; theme.value = shared.theme ?? ''; strict.checked = shared.strict !== false; tailwind.checked = shared.tailwind === true;
      }
    } catch { setStatus(messages.invalid, 'error'); }
  }
  request();
</script>

<style>
  .theme-panel { padding:.7rem 1rem; border-top:1px solid var(--rsx-border); }
  .theme-panel p { font-size:.75rem; }
  #rsx-theme { width:100%; min-height:110px; font:12px/1.6 ui-monospace,monospace; }
  .rsx-playground { margin-block:1.75rem; }
  .workbench,.expansion-panel,.diagnostics-panel { border:1px solid var(--rsx-border); border-radius:10px; overflow:hidden; background:var(--rsx-surface); }
  .workspace { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .editor-panel,.preview-panel { display:flex; flex-direction:column; min-width:0; }
  .editor-panel { border-inline-end:1px solid var(--rsx-border); }
  .toolbar { display:flex; flex-wrap:wrap; justify-content:space-between; gap:1rem; align-items:center; padding:.8rem 1rem; background:var(--rsx-surface-raised); border-bottom:1px solid var(--rsx-border); }
  .options,.actions { display:flex; flex-wrap:wrap; gap:.5rem 1rem; align-items:center; }
  .actions { gap:.4rem; }
  .toolbar label { display:flex; gap:.4rem; align-items:center; font-size:.75rem; cursor:pointer; }
  input { accent-color:var(--rsx-action); width:.9rem; height:.9rem; }
  button { cursor:pointer; background:var(--rsx-surface); color:var(--sl-color-text); border:1px solid var(--rsx-border); border-radius:5px; min-height:2.25rem; padding:.4rem .65rem; font:500 .72rem var(--sl-font); }
  button:hover { border-color:var(--sl-color-accent); }
  .share-button { background:var(--rsx-action); color:var(--rsx-action-text); border-color:var(--rsx-action); }
  .share-button:hover { background:var(--rsx-action-hover); }
  .editor-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.7rem 1rem; border-bottom:1px solid var(--rsx-border); }
  .editor-heading label { font-size:.8rem; font-weight:600; }
  .editor-heading label span { margin-inline-start:.65rem; font:.6rem var(--sl-font-mono); color:var(--sl-color-text-accent); }
  .editor-hint { font-size:.7rem; color:var(--sl-color-gray-3); }
  textarea { display:block; flex:1; width:100%; min-height:27rem; resize:vertical; font:12px/1.8 var(--sl-font-mono); color:var(--sl-color-text); background:var(--sl-color-bg); border:0; border-radius:0; padding:1rem; tab-size:4; }
  textarea:focus-visible { outline-offset:-3px; }
  #rsx-status { display:flex; align-items:baseline; gap:.6rem; padding:.65rem 1rem; margin:0; border-top:1px solid var(--rsx-border); font-size:.72rem; color:var(--sl-color-gray-2); min-height:2.5rem; }
  #rsx-status::before { content:''; width:6px; height:6px; flex-shrink:0; border-radius:50%; background:var(--sl-color-accent); }
  #rsx-status[data-state='checking']::before { background:var(--sl-color-gray-3); }
  #rsx-status[data-state='error']::before { background:#dc704e; }
  .panel-heading { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:.7rem 1rem; border-bottom:1px solid var(--rsx-border); }
  .panel-heading h2 { font-size:.8rem; font-weight:600; color:var(--sl-color-white); margin:0; }
  .panel-heading > span,.language-label { font:.6rem var(--sl-font-mono); color:var(--sl-color-gray-3); }
  .panel-heading .live-indicator { display:flex; align-items:center; gap:.4rem; font:.65rem var(--sl-font); }
  .live-indicator::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--sl-color-accent); }
  pre { max-height:26rem; margin:0; overflow:auto; font:12px/1.8 var(--sl-font-mono); padding:1rem; background:var(--sl-color-bg); }
  iframe { display:block; width:100%; flex:1; min-height:24rem; background:#f5f6f8; border:0; }
  .preview-note { font-size:.65rem; line-height:1.6; color:var(--sl-color-gray-3); padding:.65rem 1rem; margin:0; border-top:1px solid var(--rsx-border); }
  .preview-limitations { margin-top:.75rem; padding:.65rem .85rem; border-inline-start:2px solid var(--rsx-border); color:var(--sl-color-gray-2); font-size:.75rem; }
  .preview-limitations summary { cursor:pointer; }
  .preview-limitations ul { list-style:none; margin:.75rem 0 0; padding:0; }
  .preview-limitations :global(li) { display:flex; gap:.6rem; flex-wrap:wrap; padding:.3rem 0; }
  .preview-limitations :global(code) { color:var(--sl-color-text-accent); }
  .expansion-panel { margin-top:1rem; }
  .expansion-panel summary { display:flex; align-items:center; gap:.6rem; padding:.8rem 1rem; cursor:pointer; color:var(--sl-color-gray-1); font-size:.8rem; font-weight:600; }
  .expansion-panel summary::before { content:'›'; font-size:1rem; line-height:1; color:var(--sl-color-gray-3); }
  .expansion-panel[open] summary::before { transform:rotate(90deg); }
  .expansion-panel summary::-webkit-details-marker { display:none; }
  .expansion-panel .language-label { margin-inline-start:auto; font-weight:400; }
  .expansion-panel[open] summary { border-bottom:1px solid var(--rsx-border); }
  .diagnostics-panel { margin-top:1rem; }
  #rsx-diagnostics { list-style:none; padding:1rem; margin:0; font-size:.8rem; }
  #rsx-diagnostics :global(li + li) { margin-top:.5rem; }
  #rsx-diagnostics :global(button) { width:100%; text-align:left; white-space:pre-wrap; overflow-wrap:anywhere; font-size:.75rem; padding:.6rem .75rem; }
  #rsx-diagnostics :global(button[data-severity='error']) { border-inline-start:3px solid #dc704e; }
  #rsx-diagnostics :global(.empty-diagnostics) { color:var(--sl-color-gray-3); }
  @media (max-width:64rem) { .workspace { grid-template-columns:1fr; } .editor-panel { border-inline-end:0; border-bottom:1px solid var(--rsx-border); } .editor-hint { display:none; } .toolbar { padding:.8rem; } textarea { min-height:22rem; } iframe { flex:none; height:25rem; } }
</style>
