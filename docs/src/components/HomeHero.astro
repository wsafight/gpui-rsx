---
import { Code, Icon } from '@astrojs/starlight/components';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';

const { lang, entry } = Astro.locals.starlightRoute;
const isHome = entry.id === '' || entry.id === 'zh-cn';
const zh = lang.toLowerCase().startsWith('zh');
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${zh ? 'zh-cn/' : ''}`;
const text = zh ? {
  first: '用 RSX 编写',
  second: 'GPUI 原生界面',
  description: '在 Rust 里用标签组织视图，用 class 描述布局。静态 RSX 在编译时展开为 GPUI builder 调用，表达式和类型检查仍然交给 Rust。',
  start: '快速开始',
  try: '在线体验',
  installation: '安装说明',
  codeNote: '这段静态标记会直接编译为 GPUI 调用。',
  syntax: '查看语法',
} : {
  first: 'Write GPUI views',
  second: 'with RSX.',
  description: 'Organize views with tags and describe layouts with classes, right inside Rust. Static RSX expands into GPUI builder calls at compile time. Rust handles expressions and type checking.',
  start: 'Getting started',
  try: 'Open playground',
  installation: 'Installation',
  codeNote: 'This static markup compiles to GPUI calls.',
  syntax: 'Read the syntax guide',
};
const code = `rsx! {
    <div class="flex flex-col gap-[12px] p-[24px]">
        <h1 class="text-xl font-bold">
            {"Hello, GPUI."}
        </h1>
        <p>{"A view written in Rust."}</p>
    </div>
}`;
---

{isHome ? <>
  <section class="home-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 class="home-title" id="_top" data-page-title>
        <span>{text.first}</span>
        <span>{text.second}</span>
      </h1>
      <p class="hero-description">{text.description}</p>
      <div class="hero-actions">
        <a class="primary-action" href={`${base}getting-started/`}>
          {text.start}<Icon name="right-arrow" size="1rem" />
        </a>
        <a class="secondary-action" href={`${base}playground/`}>{text.try}</a>
      </div>
      <a class="install-link" href={`${base}getting-started/`} aria-label={text.installation}>
        <code>gpui-rsx = "0.11.0"</code>
        <Icon name="right-arrow" size="0.85rem" />
      </a>
    </div>

    <figure class="code-showcase">
      <div class="code-heading">
        <span>src/view.rs</span>
        <span>gpui_rsx::rsx</span>
      </div>
      <Code code={code} lang="rust" />
      <figcaption>
        <span>{text.codeNote}</span>
        <a href={`${base}usage/syntax/`}>{text.syntax}<Icon name="right-arrow" size="0.85rem" /></a>
      </figcaption>
    </figure>
  </section>

  <div class="compat-strip">
    <span>GPUI Kit <strong>0.8.1</strong></span>
    <span>Rust <strong>1.88+</strong> <small>{zh ? '宏 / core' : 'macro / core'}</small></span>
    <a href={`${base}compatibility/`}>{zh ? '查看兼容性要求' : 'Check compatibility'}<Icon name="right-arrow" size="0.85rem" /></a>
  </div>
</> : <DefaultHero />}

<style>
  .home-hero {
    display: grid;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(2.75rem, 6vw, 5rem) 3.5rem;
  }

  .hero-copy { min-width: 0; }

  .home-hero .home-title {
    color: var(--sl-color-white);
    font-size: clamp(2.1rem, 3.6vw, 3.15rem);
    font-weight: 650;
    letter-spacing: -.045em;
    line-height: 1.25;
  }

  .home-title span { display: block; }

  .hero-description {
    max-width: 43ch;
    margin-top: 1.5rem;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 1.75rem; }
  .hero-actions a { display: inline-flex; align-items: center; gap: .65rem; font-size: .875rem; font-weight: 600; text-decoration: none; }
  .primary-action { padding: .7rem 1rem; border-radius: 5px; background: var(--rsx-action); color: var(--rsx-action-text); }
  .primary-action:hover { background: var(--rsx-action-hover); }
  .secondary-action { color: var(--sl-color-white); text-underline-offset: 5px; }
  .secondary-action:hover { text-decoration: underline; }
  .install-link { display: inline-flex; align-items: center; gap: .75rem; margin-top: 1.5rem; color: var(--sl-color-gray-3); text-decoration: none; }
  .install-link code { font: .75rem var(--sl-font-mono); }
  .install-link:hover { color: var(--sl-color-text-accent); }

  .code-showcase { min-width: 0; margin: 0; overflow: hidden; border: 1px solid var(--rsx-border); border-radius: 8px; background: var(--rsx-surface); }
  .code-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; padding: .85rem 1.2rem; border-bottom: 1px solid var(--rsx-border); font: .7rem var(--sl-font-mono); color: var(--sl-color-gray-2); }
  .code-heading > span:last-child { color: var(--sl-color-gray-3); }
  .code-showcase :global(.expressive-code) { margin: 0; }
  .code-showcase :global(.expressive-code pre) { border: 0; border-radius: 0; }
  .code-showcase :global(.expressive-code .frame) { box-shadow: none; }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; padding: .85rem 1.2rem; border-top: 1px solid var(--rsx-border); color: var(--sl-color-gray-3); font-size: .7rem; line-height: 1.6; }
  figcaption a { display: inline-flex; align-items: center; gap: .45rem; color: var(--sl-color-text-accent); text-decoration: none; }
  figcaption a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .compat-strip { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.75rem; padding-block: 1.15rem; border-block: 1px solid var(--rsx-border); color: var(--sl-color-gray-3); font-size: .75rem; }
  .compat-strip strong { margin-inline-start: .3rem; color: var(--sl-color-gray-2); font-weight: 550; }
  .compat-strip small { font-size: .65rem; }
  .compat-strip a { display: inline-flex; align-items: center; gap: .5rem; margin-inline-start: auto; color: var(--sl-color-text-accent); text-decoration: none; }
  .compat-strip a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 60rem) {
    .home-hero { grid-template-columns: .92fr 1.08fr; gap: 3rem; }
  }

  @media (max-width: 35rem) {
    .home-hero { padding-bottom: 2rem; }
    .hero-description { font-size: .95rem; }
    .code-heading, figcaption { padding-inline: .9rem; }
    .compat-strip { gap: .6rem 1.25rem; }
    .compat-strip a { margin-inline-start: 0; }
  }
</style>
