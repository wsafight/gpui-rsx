---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="rsx-brand" href={siteTitleHref}>
  <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
    <rect width="32" height="32" rx="9" fill="currentColor" />
    <path d="m11.5 10-6 6 6 6m9-12 6 6-6 6M18 8l-4 16" fill="none" stroke="var(--rsx-brand-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span translate="no">{siteTitle}</span>
  <span class="version" translate="no">0.10.2</span>
</a>

<style>
  .rsx-brand { display:flex; align-items:center; gap:.65rem; min-width:0; color:var(--sl-color-text-accent); text-decoration:none; white-space:nowrap; }
  .rsx-brand > span:first-of-type { color:var(--sl-color-white); font-size:1.05rem; font-weight:750; letter-spacing:-.035em; }
  svg { flex-shrink:0; }
  .version { border:1px solid var(--sl-color-hairline-light); border-radius:5px; padding:.1rem .35rem; color:var(--sl-color-gray-2); font:500 .65rem/1.4 var(--sl-font-mono); }
  @media (max-width:22rem) { .version { display:none; } }
</style>
