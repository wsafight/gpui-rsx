fn expanded() {
    let _ = div()
        .children(
            (items)
                .into_iter()
                .map(|item| {
                    div()
                        .id({
                            struct __RsxKey<'a, T: ?Sized>(&'a T);
                            trait __RsxKeyId {
                                type Id;
                                fn __rsx_key_id(self, prefix: &'static str) -> Self::Id;
                            }
                            impl<T: ::core::fmt::Display + ?Sized> __RsxKeyId
                            for &__RsxKey<'_, T> {
                                type Id = ::std::string::String;
                                fn __rsx_key_id(self, prefix: &'static str) -> Self::Id {
                                    ::std::format!("{}{}", prefix, self.0)
                                }
                            }
                            macro_rules! __rsx_integer_keys {
                                ($($ty:ty),*) => {
                                    $(impl __RsxKeyId for __RsxKey < '_, $ty > { type Id = (&
                                    'static str, u64); fn __rsx_key_id(self, prefix : & 'static
                                    str) -> Self::Id { (prefix, * self.0 as u64) } })*
                                };
                            }
                            __rsx_integer_keys!(
                                u8, u16, u32, u64, usize, i8, i16, i32, i64, isize
                            );
                            __RsxKey(&(item.id))
                                .__rsx_key_id(concat!(file!(), "::__rsx_li_L1C26_"))
                        })
                        .on_click(handler)
                        .child(item.name.clone())
                }),
        );
}
